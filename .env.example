# Copia este archivo como .env.local y rellena los valores.
# .env.local nunca se sube a Git (ver .gitignore).

# Panel de Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Notificaciones push (Web Push). Clave PRIVADA VAPID: secreta, solo en
# Vercel (Settings → Environment Variables) y en tu .env.local si pruebas
# en local. La pública correspondiente está en src/lib/push/config.ts.
VAPID_PRIVATE_KEY=

# Momento Ratta: clave que comparte la app con el "despertador" de Supabase
# (la misma que está en Vault como moment_cron_secret). Secreta, solo en
# Vercel. Ver supabase/README.md → "Momento Ratta".
MOMENT_CRON_SECRET=
